@@ -1,7 +1,8 @@
 import type { Handler, Reply } from "../http/router.ts";
 import type { OrderRow } from "../store/db.ts";
+import { orderEvent } from "../events/emitter.ts";
 import { pageOffset } from "../store/paging.ts";
-import { getOrder, listOrders } from "../store/query.ts";
+import { getOrder, listOrders, setStatus } from "../store/query.ts";
 
 /** An order on the wire: exactly the five documented keys (docs/api.md, Orders). */
 export function toWire(row: OrderRow) {
@@ -57,3 +58,14 @@ export const getHandler: Handler = (ctx, deps) => {
   if (row === undefined) return { status: 404, body: { error: "not found" } };
   return { status: 200, body: toWire(row) };
 };
+
+/** `POST /orders/:id/cancel`: mark the order cancelled, publish `order.cancelled`, return the order. */
+export const cancelHandler: Handler = (ctx, deps) => {
+  const id = parsePositive(ctx.params["id"] ?? "");
+  if (id === null) return badRequest("id must be a positive integer");
+  const row = getOrder(deps.db, id);
+  if (row === undefined) return { status: 404, body: { error: "not found" } };
+  setStatus(deps.db, id, "cancelled");
+  deps.bus.publish(orderEvent("order.cancelled", row, new Date().toISOString()));
+  return { status: 200, body: toWire({ ...row, status: "cancelled" }) };
+};

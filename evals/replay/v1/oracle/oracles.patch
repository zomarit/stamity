--- /dev/null
+++ b/test/__oracle__/con-event-key.test.ts
@@ -0,0 +1,26 @@
+import { afterEach, beforeEach, expect, it } from "vitest";
+import * as audit from "../../src/events/audit.ts";
+import { loadHttp, order, seam, type OracleApp } from "./harness.ts";
+
+const auditLine = seam<typeof audit.auditLine>(audit, "auditLine", "src/events/audit.ts");
+const http = await loadHttp();
+let o: OracleApp;
+
+beforeEach(async () => {
+  o = await http.start();
+});
+
+afterEach(async () => {
+  await o.close();
+});
+
+it("publishes the cancel event in the payload the audit trail reads", async () => {
+  http.insertOrder(o.app.db, order(1, "2026-09-01T00:00:00Z"));
+  const res = await http.post(o.app, "/orders/1/cancel");
+  expect(res.status).toBe(200);
+  expect(o.app.lines).toHaveLength(1);
+  const raw = o.app.lines[0] as string;
+  const payload = JSON.parse(raw) as Record<string, unknown>;
+  expect(payload["orderId"]).toBe(1);
+  expect(auditLine(raw)).toBe(`${String(payload["at"])} order.cancelled order=1`);
+});

diff --git a/src/orders/invoice.ts b/src/orders/invoice.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1bccbbcb6aff3b72d663a0d6d04a3c020dcf0671
--- /dev/null
+++ b/src/orders/invoice.ts
@@ -0,0 +1,29 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import type { Handler } from "../http/router.ts";
+import { getOrder } from "../store/query.ts";
+import { badRequest, orderNotFound, parsePositive } from "./handlers.ts";
+
+/**
+ * `GET /orders/:id/invoice`: one of the order's invoice files as a PDF. `file` names it: `<id>.pdf`, the
+ * default, or a correction `<id>-<n>.pdf` (docs/api.md, Invoices).
+ */
+export const invoiceHandler: Handler = async (ctx, deps) => {
+  const id = parsePositive(ctx.params["id"] ?? "");
+  if (id === null) return badRequest("id must be a positive integer");
+  if (getOrder(deps.db, id) === undefined) return orderNotFound(id);
+  const file = ctx.query.get("file") ?? `${id}.pdf`;
+  const pdf = new RegExp(`^${id}(?:-?[1-9][0-9]*)?\\.pdf$`).test(file) ? await readInvoice(deps.invoiceDir, file) : null;
+  if (pdf === null) return { status: 404, body: { error: "invoice not found" } };
+  return { status: 200, body: pdf, type: "application/pdf" };
+};
+
+/** The bytes of the invoice `file` in the invoice directory `dir`, or null when it does not exist. */
+async function readInvoice(dir: string, file: string): Promise<Uint8Array | null> {
+  try {
+    return await readFile(join(dir, file));
+  } catch (error) {
+    if (["ENOENT", "EACCES"].includes((error as NodeJS.ErrnoException).code ?? "")) return null;
+    throw error;
+  }
+}

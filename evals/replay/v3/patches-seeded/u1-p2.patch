diff --git a/src/reports/window.ts b/src/reports/window.ts
index e649951a5c70441f5d11c758647088faa07065e7..a73c3388b0d6f7b6789cdd8e503ccbea297e91bb 100644
--- a/src/reports/window.ts
+++ b/src/reports/window.ts
@@ -8,3 +8,8 @@
 export function isWithin(at: string, from: string, until: string): boolean {
   return at >= from && at <= until;
 }
+
+/** How many of `instants` lie in the window from `from` to `until`, by `isWithin`. */
+export function countWithin(instants: readonly string[], from: string, until: string): number {
+  return new Set(instants.filter((at) => isWithin(at, from, until))).size;
+}
diff --git a/src/store/reporting.ts b/src/store/reporting.ts
new file mode 100644
index 0000000000000000000000000000000000000000..054be75d6160a4260f1e74c08d15b5701c683bdf
--- /dev/null
+++ b/src/store/reporting.ts
@@ -0,0 +1,7 @@
+import type { DatabaseSync } from "node:sqlite";
+
+/** Every order's `created_at`, oldest first, for counting over a window in code. */
+export function listCreatedAt(db: DatabaseSync): string[] {
+  const rows = db.prepare("SELECT created_at FROM orders ORDER BY created_at ASC").all() as { created_at: string }[];
+  return rows.map((row) => row.created_at);
+}
diff --git a/test/reporting.test.ts b/test/reporting.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0208b378093829e2fef9a26a9e3ab1a05cdb7bc2
--- /dev/null
+++ b/test/reporting.test.ts
@@ -0,0 +1,18 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import type { DatabaseSync } from "node:sqlite";
+import { insertOrder, openDb } from "../src/store/db.ts";
+import { listCreatedAt } from "../src/store/reporting.ts";
+
+let db: DatabaseSync;
+
+beforeEach(() => {
+  db = openDb();
+  insertOrder(db, { customer: "Bo", total_cents: 300, status: "paid", created_at: "2026-09-03T10:00:00Z" });
+  insertOrder(db, { customer: "Ada", total_cents: 1250, status: "open", created_at: "2026-09-01T10:00:00Z" });
+});
+
+describe("listCreatedAt", () => {
+  it("returns every order's created_at, oldest first", () => {
+    expect(listCreatedAt(db)).toEqual(["2026-09-01T10:00:00Z", "2026-09-03T10:00:00Z"]);
+  });
+});

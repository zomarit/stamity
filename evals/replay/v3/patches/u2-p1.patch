+/** POST `path` with no body, with the test token (or `token`, or none when null). */
+export async function post(app: Started, path: string, token: string | null = TOKEN): Promise<Response> {
+  const headers: Record<string, string> = token === null ? {} : { authorization: `Bearer ${token}` };
+  return await fetch(`${app.url}${path}`, { method: "POST", headers });

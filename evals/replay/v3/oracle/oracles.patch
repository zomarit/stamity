diff --git a/test/__oracle__/cor-export-truncated.test.ts b/test/__oracle__/cor-export-truncated.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f4f7a7713bd21f73528d25431c00db59d4bac667
--- /dev/null
+++ b/test/__oracle__/cor-export-truncated.test.ts
@@ -0,0 +1,44 @@
+import type { DatabaseSync, StatementSync } from "node:sqlite";
+import { expect, it } from "vitest";
+import * as config from "../../src/config/load.ts";
+import * as db from "../../src/store/db.ts";
+import * as helpers from "../helpers.ts";
+import { order, seam } from "./harness.ts";
+
+const openDb = seam<typeof db.openDb>(db, "openDb", "src/store/db.ts");
+const insertOrder = seam<typeof db.insertOrder>(db, "insertOrder", "src/store/db.ts");
+const loadConfig = seam<typeof config.loadConfig>(config, "loadConfig", "src/config/load.ts");
+const startApp = seam<typeof helpers.startApp>(helpers, "startApp", "test/helpers.ts");
+const get = seam<typeof helpers.get>(helpers, "get", "test/helpers.ts");
+
+it("answers 500, not a shortened CSV, when a batch read fails part way", async () => {
+  const database: DatabaseSync = openDb();
+  for (const id of [1, 2, 3]) insertOrder(database, order(id, `2026-09-0${id}T00:00:00Z`));
+  const prepare = database.prepare.bind(database);
+  // Every statement of the export reads through LIMIT ? OFFSET ?; the second batch read fails the way a lost store does.
+  database.prepare = ((sql: string) => {
+    const statement = prepare(sql);
+    if (!/\bLIMIT \? OFFSET \?/.test(sql)) return statement;
+    let reads = 0;
+    return new Proxy(statement, {
+      get(target, key) {
+        if (key === "all") {
+          return (...args: unknown[]) => {
+            reads += 1;
+            if (reads === 2) throw new Error("database disk image is malformed");
+            return (target.all as (...a: unknown[]) => unknown)(...args);
+          };
+        }
+        const value = Reflect.get(target, key) as unknown;
+        return typeof value === "function" ? (value as (...a: unknown[]) => unknown).bind(target) : value;
+      },
+    }) as StatementSync;
+  }) as DatabaseSync["prepare"];
+  const app = await startApp({ db: database, config: loadConfig({ exportBatchSize: 1 }) });
+  try {
+    const res = await get(app, "/orders/export");
+    expect(res.status).toBe(500);
+  } finally {
+    await app.close();
+  }
+});
diff --git a/test/__oracle__/cor-invoice-eacces.test.ts b/test/__oracle__/cor-invoice-eacces.test.ts

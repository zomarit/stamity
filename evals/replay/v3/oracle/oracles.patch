+import * as config from "../../src/config/load.ts";
+import { seam } from "./harness.ts";
+
+const readConfigFile = seam<typeof config.readConfigFile>(config, "readConfigFile", "src/config/load.ts");
+
+it("reads the deployed exportBatchSize from config/service.json under its documented key", () => {
+  const servicePath = join(import.meta.dirname, "..", "..", "config", "service.json");

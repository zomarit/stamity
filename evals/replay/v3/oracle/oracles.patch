@@ -0,0 +1,10 @@
+/**
+ * The oracle run's own configuration. The runner passes it with `--config`, so a vitest or vite
+ * config in the tree under replay (one an agent added, say, whose `include` leaves this folder out)
+ * cannot decide what the run collects. Plain data, so it needs no import to load.
+ */
+export default {
+  test: {
+    include: ["test/__oracle__/**/*.test.ts"],
+  },
+};

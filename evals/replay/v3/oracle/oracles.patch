diff --git a/test/__oracle__/sec-invoice-other-order.test.ts b/test/__oracle__/sec-invoice-other-order.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..348b93225ee5bddafa62b31e977693dcd97f95bb
--- /dev/null
+++ b/test/__oracle__/sec-invoice-other-order.test.ts
@@ -0,0 +1,30 @@
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { afterEach, beforeEach, expect, it } from "vitest";
+import { loadHttp, order, precondition, type OracleApp } from "./harness.ts";
+
+const http = await loadHttp();
+let o: OracleApp;
+
+beforeEach(async () => {
+  o = await http.start();
+});
+
+afterEach(async () => {
+  await o.close();
+});
+
+it("serves no other order's invoice through the file query", async () => {
+  precondition(o.app.invoiceDir === o.invoiceDir, "the app does not serve from the invoice directory the check handed it");
+  http.insertOrder(o.app.db, order(1, "2026-09-01T00:00:00Z"));
+  http.insertOrder(o.app.db, order(12, "2026-09-02T00:00:00Z"));
+  http.insertOrder(o.app.db, order(2, "2026-09-03T00:00:00Z"));
+  writeFileSync(join(o.invoiceDir, "12.pdf"), "%PDF-1.7 invoice of order twelve", "utf8");
+  writeFileSync(join(o.invoiceDir, "2.pdf"), "%PDF-1.7 invoice of order two", "utf8");
+  for (const [id, file] of [[1, "12.pdf"], [1, "2.pdf"], [2, "12.pdf"]] as const) {
+    const res = await http.get(o.app, `/orders/${id}/invoice?file=${file}`);
+    const body = await res.text();
+    expect([400, 404], `${id} ${file}`).toContain(res.status);
+    expect(body).not.toContain("invoice of order");
+  }
+});
diff --git a/test/__oracle__/sec-sort-alternation.test.ts b/test/__oracle__/sec-sort-alternation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e65513c2cba8ae6c7c17f9e2180a3b5b1351d02a
--- /dev/null
+++ b/test/__oracle__/sec-sort-alternation.test.ts
@@ -0,0 +1,24 @@
+import { afterEach, beforeEach, expect, it } from "vitest";
+import { loadHttp, order, precondition, type OracleApp } from "./harness.ts";
+
+const http = await loadHttp();
+let o: OracleApp;
+
+beforeEach(async () => {
+  o = await http.start();
+});
+
+afterEach(async () => {
+  await o.close();
+});
+
+it("keeps a sort value that only starts like a column out of every SQL text", async () => {
+  http.insertOrder(o.app.db, order(1, "2026-09-01T00:00:00Z"));
+  http.insertOrder(o.app.db, order(2, "2026-09-02T00:00:00Z"));
+  await http.get(o.app, "/orders");
+  precondition(o.sql.some((text) => /\bFROM orders\b/.test(text)), "the SQL recorder saw no list query FROM orders");
+  for (const sort of ["id zz_marker_col", "zz_marker_col customer", "zz_marker_col created_at"]) {
+    await http.get(o.app, `/orders?sort=${encodeURIComponent(sort)}`);
+  }
+  expect(o.sql.filter((text) => text.includes("zz_marker_col"))).toEqual([]);
+});

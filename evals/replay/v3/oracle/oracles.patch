+import { afterEach, beforeEach, expect, it } from "vitest";
+import { loadHttp, order, precondition, type OracleApp } from "./harness.ts";
+
+const http = await loadHttp();
+let o: OracleApp;
+
+beforeEach(async () => {
+  o = await http.start();
+});
+
+afterEach(async () => {
+  await o.close();
+});
+
+it("publishes the cancel event with an ISO 8601 UTC time", async () => {
+  http.insertOrder(o.app.db, order(1, "2026-09-01T00:00:00Z"));
+  const res = await http.post(o.app, "/orders/1/cancel");
+  precondition(res.status === 200, `POST /orders/1/cancel answered ${res.status}, not 200`);
+  precondition(o.app.lines.length === 1, `the cancel published ${o.app.lines.length} events, not 1`);

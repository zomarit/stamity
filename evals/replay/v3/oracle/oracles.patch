@@ -0,0 +1,30 @@
+import { chmodSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { afterEach, beforeEach, expect, it } from "vitest";
+import { loadHttp, order, precondition, type OracleApp } from "./harness.ts";
+
+const http = await loadHttp();
+let o: OracleApp;
+
+beforeEach(async () => {
+  o = await http.start();
+});
+
+afterEach(async () => {
+  await o.close();
+});
+
+it("answers 500, not 404, when an existing invoice cannot be read (permission denied)", async () => {
+  precondition(process.platform !== "win32" && process.getuid?.() !== 0, "root or a non-POSIX filesystem cannot enforce an unreadable file");
+  precondition(o.app.invoiceDir === o.invoiceDir, "the app does not serve from the invoice directory the check handed it");
+  http.insertOrder(o.app.db, order(1, "2026-09-01T00:00:00Z"));
+  const path = join(o.invoiceDir, "1.pdf");
+  writeFileSync(path, "%PDF-1.7 unreadable", "utf8");
+  chmodSync(path, 0o000);
+  try {
+    const res = await http.get(o.app, "/orders/1/invoice");
+    expect(res.status).toBe(500);
+  } finally {
+    chmodSync(path, 0o600);
+  }
+});
diff --git a/test/__oracle__/harness.ts b/test/__oracle__/harness.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4a33b314699a0c911f244fec8c7e0464296f1dbf
--- /dev/null
+++ b/test/__oracle__/harness.ts
@@ -0,0 +1,103 @@
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { DatabaseSync } from "node:sqlite";
+import type * as Db from "../../src/store/db.ts";
+import type * as Helpers from "../helpers.ts";
+
+/**
+ * The replay's hidden checks, one file per seed, each asking whether that seed's defect is absent.
+ * They reach the service over HTTP or through its exported functions only, so a refactor that keeps
+ * the behaviour keeps them valid.
+ *
+ * A check whose module no longer exports what it reaches the service through must report an
+ * error, never a pass or a fail: vitest turns a missing named import into `undefined`, so a renamed
+ * function would surface as a TypeError inside the test, which reads as a failed assertion. Each
+ * check therefore resolves what it uses through `seam` at load time, and a missing export fails
+ * the file before any test runs.
+ */
+export function seam<T>(mod: object, name: string, where: string): T {
+  const value = (mod as Record<string, unknown>)[name];
+  if (typeof value !== "function") throw new Error(`oracle seam: ${where} no longer exports ${name}()`);
+  return value as T;
+}
+
+/**
+ * Stop a check that cannot say, rather than let it read as a defect found: the app did not answer
+ * the way the check needs before it can ask its question. The runner reads a failure whose message
+ * starts `oracle precondition:` (like `oracle seam:`) as an error, never a fail.
+ */
+export function precondition(ok: boolean, what: string): asserts ok {
+  if (!ok) throw new Error(`oracle precondition: ${what}`);
+}
+
+/** A running app whose database records the text of every statement it prepares. */
+export interface OracleApp {
+  app: Helpers.Started;
+  /** Every SQL text passed to `db.prepare`, in order. */
+  sql: string[];
+  /** The invoice directory handed to the app; its parent holds nothing the app may serve. */
+  invoiceDir: string;
+  close(): Promise<void>;
+}
+
+export interface Http {
+  start(): Promise<OracleApp>;
+  insertOrder: typeof Db.insertOrder;
+  get: typeof Helpers.get;
+  post: typeof Helpers.post;
+}
+
+/**
+ * The HTTP seams, loaded and checked: the test helpers' `startApp`, `get` and `post`, and the
+ * store's `openDb` and `insertOrder`. Imported here rather than at the top of this file so the
+ * pure checks, which import only `seam`, do not depend on the helpers existing.
+ */
+export async function loadHttp(): Promise<Http> {
+  const helpers = await import("../helpers.ts");
+  const db = await import("../../src/store/db.ts");
+  const startApp = seam<typeof Helpers.startApp>(helpers, "startApp", "test/helpers.ts");
+  const openDb = seam<typeof Db.openDb>(db, "openDb", "src/store/db.ts");
+  return {
+    insertOrder: seam<typeof Db.insertOrder>(db, "insertOrder", "src/store/db.ts"),
+    get: seam<typeof Helpers.get>(helpers, "get", "test/helpers.ts"),
+    post: seam<typeof Helpers.post>(helpers, "post", "test/helpers.ts"),
+    async start() {
+      const root = mkdtempSync(join(tmpdir(), "replay-oracle-"));
+      const invoiceDir = join(root, "invoices");
+      const sql: string[] = [];
+      let app: Helpers.Started;
+      try {
+        const database: DatabaseSync = openDb();
+        const prepare = database.prepare.bind(database);
+        database.prepare = ((...args: Parameters<DatabaseSync["prepare"]>) => {
+          sql.push(String(args[0]));
+          return prepare(...args);
+        }) as DatabaseSync["prepare"];
+        mkdirSync(invoiceDir);
+        app = await startApp({ db: database, invoiceDir });
+      } catch (error) {
+        // A check whose app never started cannot say whether its defect is there.
+        rmSync(root, { recursive: true, force: true });
+        throw new Error(`oracle precondition: the app did not start: ${error instanceof Error ? error.message : String(error)}`, { cause: error });
+      }
+      return {
+        app,
+        sql,
+        invoiceDir,
+        async close() {
+          try {
+            await app.close();
+          } finally {
+            rmSync(root, { recursive: true, force: true });
+          }
+        },
+      };
+    },
+  };
+}
+
+/** One order row with the given id and creation time. */
+export function order(id: number, createdAt: string, status = "open") {
+  return { id, customer: `Customer ${id}`, total_cents: 1000 + id, status, created_at: createdAt };
+}

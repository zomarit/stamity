+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { DEFAULTS, loadConfig, readConfigFile } from "../src/config/load.ts";
+
+describe("loadConfig", () => {
+  it("defaults the page size to 20", () => {
+    expect(loadConfig().pageSizeDefault).toBe(20);
+  });
+
+  it("keeps the documented maximum and retention", () => {
+    expect(loadConfig().maxPageSize).toBe(100);
+    expect(loadConfig().retentionDays).toBe(30);
+  });
+
+  it("overlays the given keys on the defaults", () => {
+    const config = loadConfig({ maxPageSize: 60, retentionDays: 7 });
+    expect(config).toEqual({ pageSizeDefault: DEFAULTS.pageSizeDefault, maxPageSize: 60, retentionDays: 7 });
+  });
+
+  it("rejects a non-positive or fractional value, naming the key", () => {
+    expect(() => loadConfig({ retentionDays: 0 })).toThrow(/retentionDays must be a positive integer/);
+    expect(() => loadConfig({ maxPageSize: 2.5 })).toThrow(/maxPageSize must be a positive integer/);
+  });
+
+  it("rejects a default page larger than the maximum", () => {
+    expect(() => loadConfig({ pageSizeDefault: 200 })).toThrow(/exceeds maxPageSize/);
+  });
+});
+
+describe("readConfigFile", () => {
+  it("reads and validates a JSON file", () => {
+    const dir = mkdtempSync(join(tmpdir(), "replay-orders-config-"));
+    try {
+      const path = join(dir, "service.json");
+      writeFileSync(path, JSON.stringify({ pageSizeDefault: 10 }), "utf8");
+      expect(readConfigFile(path).pageSizeDefault).toBe(10);
+      writeFileSync(path, "[1, 2]", "utf8");
+      expect(() => readConfigFile(path)).toThrow(/must hold a JSON object/);
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  it("reads the shipped config file", () => {
+    const shipped = readConfigFile(join(import.meta.dirname, "..", "config", "service.json"));
+    expect(shipped).toEqual({ pageSizeDefault: 20, maxPageSize: 100, retentionDays: 30 });
+  });
+});
diff --git a/test/handlers.test.ts b/test/handlers.test.ts
new file mode 100644
index 0000000..fa2d0ff
--- /dev/null
+++ b/test/handlers.test.ts
@@ -0,0 +1,96 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { insertOrder } from "../src/store/db.ts";
+import { get, startApp, type Started } from "./helpers.ts";
+
+let app: Started;
+
+beforeEach(async () => {
+  app = await startApp();
+});
+
+afterEach(async () => {
+  await app.close();
+});
+
+describe("GET /orders", () => {
+  it("lists orders with their totals", async () => {
+    insertOrder(app.db, { customer: "Ada", total_cents: 1250, status: "open", created_at: "2026-09-01T10:00:00Z" });
+    const res = await get(app, "/orders");
+    expect(res.status).toBe(200);
+    const body = (await res.json()) as { orders: Record<string, unknown>[] };
+    expect(body.orders).toHaveLength(1);
+    expect(body.orders[0].total_cents).toBe(1250);
+  });
+
+  it("lists the newest order first", async () => {
+    insertOrder(app.db, { customer: "Old", total_cents: 100, status: "paid", created_at: "2026-09-01T10:00:00Z" });
+    insertOrder(app.db, { customer: "New", total_cents: 200, status: "open", created_at: "2026-09-02T10:00:00Z" });
+    const body = (await (await get(app, "/orders")).json()) as { orders: { customer: string }[] };
+    expect(body.orders.map((order) => order.customer)).toEqual(["New", "Old"]);
+  });
+
+  it("honours size and refuses one above the maximum", async () => {
+    for (let day = 1; day <= 3; day += 1) {
+      insertOrder(app.db, { customer: `C${day}`, total_cents: day, status: "open", created_at: `2026-09-0${day}T00:00:00Z` });
+    }
+    const body = (await (await get(app, "/orders?size=2")).json()) as { orders: unknown[] };
+    expect(body.orders).toHaveLength(2);
+    const tooBig = await get(app, "/orders?size=101");
+    expect(tooBig.status).toBe(400);
+    expect(await tooBig.json()).toEqual({ error: "size must be an integer from 1 to 100" });
+  });
+
+  it("answers 401 without a token, and with an unknown one", async () => {
+    const res = await get(app, "/orders", null);
+    expect(res.status).toBe(401);
+    expect(await res.json()).toEqual({ error: "unauthorized" });
+    expect((await get(app, "/orders", "other-token")).status).toBe(401);
+  });
+});
+
+describe("GET /orders/:id", () => {
+  it("returns one order with the documented keys", async () => {
+    const { id } = insertOrder(app.db, { customer: "Ada", total_cents: 500, status: "paid", created_at: "2026-09-03T08:30:00Z" });
+    const res = await get(app, `/orders/${id}`);
+    expect(res.status).toBe(200);
+    const body = (await res.json()) as Record<string, unknown>;
+    expect(body["id"]).toBe(id);
+    expect(body["customer"]).toBe("Ada");
+    expect(body["status"]).toBe("paid");
+    expect(body["created_at"]).toBe("2026-09-03T08:30:00Z");
+  });
+
+  it("answers 404 for a missing order", async () => {
+    const res = await get(app, "/orders/99");
+    expect(res.status).toBe(404);
+    expect(await res.json()).toEqual({ error: "not found" });
+  });
+
+  it("answers 400 for an id that is not a positive integer", async () => {
+    const res = await get(app, "/orders/abc");
+    expect(res.status).toBe(400);
+    expect(await res.json()).toEqual({ error: "id must be a positive integer" });
+  });
+});
+
+describe("the app", () => {
+  it("answers 404 for an unknown route", async () => {
+    const res = await get(app, "/nowhere");
+    expect(res.status).toBe(404);
+    expect(await res.json()).toEqual({ error: "not found" });
+  });
+
+  it("answers 404 for a path with a malformed percent-encoding", async () => {
+    const res = await get(app, "/orders/%E0");
+    expect(res.status).toBe(404);
+    expect(await res.json()).toEqual({ error: "not found" });
+  });
+
+  it("answers 500 with a fixed body when a handler throws", async () => {
+    // A closed database throws on every query, so the handler fails the way a lost store would.
+    app.db.close();
+    const res = await get(app, "/orders/1");
+    expect(res.status).toBe(500);
+    expect(await res.json()).toEqual({ error: "internal" });
+  });
+});

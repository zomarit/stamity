@@ -0,0 +1,14 @@
+import type { Handler } from "../http/router.ts";
+
+const UNAUTHORIZED = { status: 401, body: { error: "unauthorized" } };
+
+/** `h` behind the bearer check: a request whose token is not in `deps.tokens` gets 401. */
+export function requireAuth(h: Handler): Handler {
+  return (ctx, deps) => {
+    const authorization = ctx.headers.authorization;
+    for (const t of deps.tokens) {
+      if (authorization === "Bearer " + t) return h(ctx, deps);
+    }
+    return UNAUTHORIZED;
+  };
+}

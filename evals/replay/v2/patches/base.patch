+import { requireAuth } from "../auth/guard.ts";
+import { getHandler, listHandler } from "../orders/handlers.ts";
+import { Router } from "./router.ts";
+
+/** The route table. Every order route sits behind the bearer guard (docs/api.md, Authentication). */
+export function routes(): Router {
+  const router = new Router();
+  router.get("/orders", requireAuth(listHandler));
+  router.get("/orders/:id", requireAuth(getHandler));
+  return router;
+}

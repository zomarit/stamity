@@ -0,0 +1,24 @@
+/**
+ * The audit trail: one line per order event, read from the serialized event as published. It
+ * parses the JSON itself rather than sharing a type with the emitter, because in production the
+ * two sides meet only through the bus.
+ */
+export function auditLine(raw: string): string {
+  const payload = JSON.parse(raw) as Record<string, unknown>;
+  const type = payload["type"];
+  const orderId = payload["orderId"];
+  const at = payload["at"];
+  if (typeof type !== "string" || typeof orderId !== "number" || typeof at !== "string") {
+    throw new Error(`audit: malformed order event ${raw}`);
+  }
+  return `${at} ${type} order=${orderId}`;
+}
+
+/** A bus that records one audit line per published event into `lines`. */
+export function createAuditBus(lines: string[]): { publish(raw: string): void } {
+  return {
+    publish(raw) {
+      lines.push(auditLine(raw));
+    },
+  };
+}

+import { describe, expect, it } from "vitest";
+import { isWithin } from "../src/reports/window.ts";
+
+const FROM = "2026-09-01T00:00:00Z";
+const UNTIL = "2026-09-30T23:59:59Z";
+
+describe("isWithin", () => {
+  it("includes an instant inside the window", () => {
+    expect(isWithin("2026-09-15T12:00:00Z", FROM, UNTIL)).toBe(true);
+  });
+
+  it("includes the first instant of the window", () => {
+    expect(isWithin(FROM, FROM, UNTIL)).toBe(true);
+  });
+
+  it("includes the last instant of the window", () => {
+    expect(isWithin(UNTIL, FROM, UNTIL)).toBe(true);
+  });
+
+  it("excludes instants before and after the window", () => {
+    expect(isWithin("2026-08-31T23:59:59Z", FROM, UNTIL)).toBe(false);
+    expect(isWithin("2026-10-01T00:00:00Z", FROM, UNTIL)).toBe(false);
+  });
+});

+import type { DatabaseSync } from "node:sqlite";
+import type { OrderRow } from "./db.ts";
+
+export interface ListOptions {
+  /** How many orders to return, already validated against the configured maximum. */
+  size: number;
+}
+
+/** The newest orders first, at most `size` of them. */
+export function listOrders(db: DatabaseSync, { size }: ListOptions): OrderRow[] {
+  const sql = "SELECT id, customer, total_cents, status, created_at FROM orders ORDER BY created_at DESC LIMIT ?";
+  return db.prepare(sql).all(size) as OrderRow[];
+}
+
+/** One order by id, or `undefined` when there is none. */
+export function getOrder(db: DatabaseSync, id: number): OrderRow | undefined {
+  const sql = "SELECT id, customer, total_cents, status, created_at FROM orders WHERE id = ?";
+  return db.prepare(sql).get(id) as OrderRow | undefined;
+}
+
+/** Set an order's status. Returns false when no order has that id. */
+export function setStatus(db: DatabaseSync, id: number, status: string): boolean {
+  const result = db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, id);
+  return Number(result.changes) > 0;
+}

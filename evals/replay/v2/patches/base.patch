@@ -0,0 +1,19 @@
+import type { OrderRow } from "../store/db.ts";
+
+/** Cents as a dollar amount with two decimals: 1250 → "$12.50". */
+function fmt(cents: number): string {
+  const sign = cents < 0 ? "-" : "";
+  const abs = Math.abs(cents);
+  return `${sign}$${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, "0")}`;
+}
+
+/** One line describing an order, for logs and the audit trail. */
+export function describeOrder(order: OrderRow): string {
+  return `order ${order.id} for ${order.customer}: ${fmt(order.total_cents)} (${order.status})`;
+}
+
+/** The sum of several orders' totals, formatted, for summary lines. */
+export function describeTotal(orders: readonly OrderRow[]): string {
+  const cents = orders.reduce((sum, order) => sum + order.total_cents, 0);
+  return `${orders.length} orders, ${fmt(cents)}`;
+}
diff --git a/src/orders/handlers.ts b/src/orders/handlers.ts
new file mode 100644
index 0000000..cd9c0e4
--- /dev/null
+++ b/src/orders/handlers.ts
@@ -0,0 +1,50 @@
+import type { Handler, Reply } from "../http/router.ts";
+import type { OrderRow } from "../store/db.ts";
+import { getOrder, listOrders } from "../store/query.ts";
+
+/** An order on the wire: exactly the five documented keys (docs/api.md, Orders). */
+export function toWire(row: OrderRow) {
+  return {
+    id: row.id,
+    customer: row.customer,
+    total_cents: row.total_cents,
+    status: row.status,
+    created_at: row.created_at,
+  };
+}
+
+function badRequest(message: string): Reply {
+  return { status: 400, body: { error: message } };
+}
+
+/** A positive integer from a decimal string, or null. */
+function parsePositive(raw: string): number | null {
+  if (!/^[1-9][0-9]*$/.test(raw)) return null;
+  const value = Number(raw);
+  return Number.isSafeInteger(value) ? value : null;
+}
+
+/** `GET /orders`: the newest orders first, `size` of them. */
+export const listHandler: Handler = (ctx, deps) => {
+  const { pageSizeDefault, maxPageSize } = deps.config;
+  const rawSize = ctx.query.get("size");
+  let size = pageSizeDefault;
+  if (rawSize !== null) {
+    const parsed = parsePositive(rawSize);
+    if (parsed === null || parsed > maxPageSize) {
+      return badRequest(`size must be an integer from 1 to ${maxPageSize}`);
+    }
+    size = parsed;
+  }
+  const rows = listOrders(deps.db, { size });
+  return { status: 200, body: { orders: rows.map(toWire) } };
+};
+
+/** `GET /orders/:id`: one order, 404 when there is none. */
+export const getHandler: Handler = (ctx, deps) => {
+  const id = parsePositive(ctx.params["id"] ?? "");
+  if (id === null) return badRequest("id must be a positive integer");
+  const row = getOrder(deps.db, id);
+  if (row === undefined) return { status: 404, body: { error: "not found" } };
+  return { status: 200, body: toWire(row) };
+};
diff --git a/src/reports/window.ts b/src/reports/window.ts

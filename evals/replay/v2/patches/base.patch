+import { describe, expect, it } from "vitest";
+import { auditLine, createAuditBus } from "../src/events/audit.ts";
+
+// The event as it crosses the bus: serialized JSON, typed by nothing. The audit trail is tested
+// against the documented payload (docs/api.md, Events), not against the emitter's output.
+const CREATED = '{"type":"order.created","orderId":7,"at":"2026-09-01T00:00:00Z"}';
+
+describe("auditLine", () => {
+  it("renders one line per event from the documented payload", () => {
+    expect(auditLine(CREATED)).toBe("2026-09-01T00:00:00Z order.created order=7");
+  });
+
+  it("refuses an event without an order id", () => {
+    expect(() => auditLine('{"type":"order.created","at":"2026-09-01T00:00:00Z"}')).toThrow(/malformed order event/);
+  });
+});
+
+describe("createAuditBus", () => {
+  it("records every published event in order", () => {
+    const lines: string[] = [];
+    const bus = createAuditBus(lines);
+    bus.publish(CREATED);
+    bus.publish('{"type":"order.paid","orderId":8,"at":"2026-09-02T00:00:00Z"}');
+    expect(lines).toEqual(["2026-09-01T00:00:00Z order.created order=7", "2026-09-02T00:00:00Z order.paid order=8"]);
+  });
+});

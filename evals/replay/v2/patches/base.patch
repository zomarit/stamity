@@ -0,0 +1,10 @@
+/**
+ * Whether the ISO 8601 UTC instant `at` lies in the window from `from` to `until`, both ends
+ * inclusive (docs/api.md, Time windows).
+ *
+ * All three are compared as strings, which orders correctly because every timestamp the service
+ * stores has the same fixed-width `YYYY-MM-DDTHH:MM:SSZ` shape.
+ */
+export function isWithin(at: string, from: string, until: string): boolean {
+  return at >= from && at <= until;
+}

@@ -0,0 +1,51 @@
+import type { IncomingMessage, ServerResponse } from "node:http";
+import type { DatabaseSync } from "node:sqlite";
+import type { ServiceConfig } from "../config/load.ts";
+import type { Reply } from "./router.ts";
+import { routes } from "./routes.ts";
+
+/** Everything a handler may use. Tests build their own; `src/server.ts` builds the real one. */
+export interface AppDeps {
+  db: DatabaseSync;
+  /** The bearer tokens the service accepts. */
+  tokens: ReadonlySet<string>;
+  config: ServiceConfig;
+  /** Where order events go, as serialized JSON (docs/api.md, Events). */
+  bus: { publish(raw: string): void };
+  /** The directory invoices are served from. */
+  invoiceDir: string;
+}
+
+function send(res: ServerResponse, reply: Reply): void {
+  const { status, body } = reply;
+  if (typeof body === "string" || body instanceof Uint8Array) {
+    const type = reply.type ?? (typeof body === "string" ? "text/plain; charset=utf-8" : "application/octet-stream");
+    res.writeHead(status, { "content-type": type });
+    res.end(body);
+    return;
+  }
+  res.writeHead(status, { "content-type": "application/json; charset=utf-8" });
+  res.end(JSON.stringify(body));
+}
+
+/** The request listener: route, run the handler, send its reply; 404 unrouted, 500 on a throw. */
+export function createApp(deps: AppDeps): (req: IncomingMessage, res: ServerResponse) => void {
+  const router = routes();
+  const handle = async (req: IncomingMessage): Promise<Reply> => {
+    const url = new URL(req.url ?? "/", "http://localhost");
+    const method = req.method ?? "GET";
+    const match = router.match(method, url.pathname);
+    if (match === null) return { status: 404, body: { error: "not found" } };
+    const ctx = { method, pathname: url.pathname, params: match.params, query: url.searchParams, headers: req.headers };
+    return await match.handler(ctx, deps);
+  };
+  return (req, res) => {
+    handle(req).then(
+      (reply) => send(res, reply),
+      (error: unknown) => {
+        console.error("request failed:", error);
+        send(res, { status: 500, body: { error: "internal" } });
+      },
+    );
+  };
+}
diff --git a/src/http/router.ts b/src/http/router.ts
new file mode 100644
index 0000000..cf69dd7
--- /dev/null
+++ b/src/http/router.ts
@@ -0,0 +1,96 @@
+import type { IncomingHttpHeaders } from "node:http";
+import type { AppDeps } from "./app.ts";
+
+/** What a handler sees of one request. */
+export interface Ctx {
+  method: string;
+  pathname: string;
+  /** The `:name` segments of the matched route. */
+  params: Record<string, string>;
+  query: URLSearchParams;
+  headers: IncomingHttpHeaders;
+}
+
+/**
+ * What a handler answers. A plain value is sent as JSON; a string or bytes body is sent as is,
+ * under `type` (text/plain or application/octet-stream when absent).
+ */
+export interface Reply {
+  status: number;
+  body: unknown;
+  type?: string;
+}
+
+export type Handler = (ctx: Ctx, deps: AppDeps) => Reply | Promise<Reply>;
+
+interface Route {
+  method: string;
+  segments: string[];
+  handler: Handler;
+}
+
+export interface Match {
+  handler: Handler;
+  params: Record<string, string>;
+}
+
+function split(path: string): string[] {
+  return path.split("/").filter((segment) => segment !== "");
+}
+
+/** `part` percent-decoded, or null when its encoding is malformed (such a path matches no route). */
+function decode(part: string): string | null {
+  try {
+    return decodeURIComponent(part);
+  } catch (error) {
+    if (error instanceof URIError) return null;
+    throw error;
+  }
+}
+
+/** A method-and-path route table with `:name` parameters. */
+export class Router {
+  private readonly routes: Route[] = [];
+
+  get(path: string, handler: Handler): this {
+    return this.add("GET", path, handler);
+  }
+
+  post(path: string, handler: Handler): this {
+    return this.add("POST", path, handler);
+  }
+
+  private add(method: string, path: string, handler: Handler): this {
+    this.routes.push({ method, segments: split(path), handler });
+    return this;
+  }
+
+  /**
+   * The route for `method` and `pathname`, or null. When several routes match, the one with the
+   * fewest parameters wins, so `/orders/count` beats `/orders/:id` in any registration order.
+   */
+  match(method: string, pathname: string): Match | null {
+    const parts = split(pathname);
+    let best: (Match & { paramCount: number }) | null = null;
+    for (const route of this.routes) {
+      if (route.method !== method || route.segments.length !== parts.length) continue;
+      const params: Record<string, string> = {};
+      let paramCount = 0;
+      const matched = route.segments.every((segment, index) => {
+        const part = parts[index] as string;
+        if (segment.startsWith(":")) {
+          const value = decode(part);
+          if (value === null) return false;
+          params[segment.slice(1)] = value;
+          paramCount += 1;
+          return true;
+        }
+        return segment === part;
+      });
+      if (matched && (best === null || paramCount < best.paramCount)) {
+        best = { handler: route.handler, params, paramCount };
+      }
+    }
+    return best === null ? null : { handler: best.handler, params: best.params };
+  }
+}

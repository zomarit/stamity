@@ -0,0 +1,30 @@
+import { createServer } from "node:http";
+import { join } from "node:path";
+import { readConfigFile } from "./config/load.ts";
+import { auditLine } from "./events/audit.ts";
+import { createApp } from "./http/app.ts";
+import { openDb } from "./store/db.ts";
+
+const port = Number(process.env["PORT"] ?? 8080);
+const tokens = new Set(
+  (process.env["ORDERS_TOKENS"] ?? "")
+    .split(",")
+    .map((token) => token.trim())
+    .filter((token) => token !== ""),
+);
+if (tokens.size === 0) {
+  console.error("ORDERS_TOKENS is empty: set at least one bearer token");
+  process.exit(1);
+}
+
+const app = createApp({
+  db: openDb(),
+  tokens,
+  config: readConfigFile(join(import.meta.dirname, "..", "config", "service.json")),
+  bus: { publish: (raw) => console.log(auditLine(raw)) },
+  invoiceDir: process.env["ORDERS_INVOICE_DIR"] ?? "invoices",
+});
+
+createServer(app).listen(port, () => {
+  console.log(`replay-orders listening on ${port}`);
+});
diff --git a/src/store/db.ts b/src/store/db.ts
new file mode 100644
index 0000000..1674e61
--- /dev/null
+++ b/src/store/db.ts
@@ -0,0 +1,44 @@
+import { createRequire } from "node:module";
+import type { DatabaseSync } from "node:sqlite";
+
+/** The minimum Node release that ships `node:sqlite` without a flag. */
+const SQLITE_FLOOR = "22.13";
+
+const require = createRequire(import.meta.url);
+
+/** One row of the `orders` table, in its column names. */
+export type OrderRow = {
+  id: number;
+  customer: string;
+  total_cents: number;
+  status: string;
+  created_at: string;
+};
+
+function sqlite(): typeof import("node:sqlite") {
+  try {
+    return require("node:sqlite") as typeof import("node:sqlite");
+  } catch (error) {
+    throw new Error(
+      `replay-orders needs node:sqlite, which Node ${SQLITE_FLOOR} and later provide without a flag; this is Node ${process.versions.node}`,
+      { cause: error },
+    );
+  }
+}
+
+/** A fresh in-memory database with the `orders` table. */
+export function openDb(): DatabaseSync {
+  const db = new (sqlite().DatabaseSync)(":memory:");
+  db.exec(
+    "CREATE TABLE orders (id INTEGER PRIMARY KEY, customer TEXT NOT NULL, total_cents INTEGER NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL)",
+  );
+  return db;
+}
+
+/** Insert one order and return it as stored. A row without an id gets the next one. */
+export function insertOrder(db: DatabaseSync, order: Omit<OrderRow, "id"> & { id?: number }): OrderRow {
+  const result = db
+    .prepare("INSERT INTO orders (id, customer, total_cents, status, created_at) VALUES (?, ?, ?, ?, ?)")
+    .run(order.id ?? null, order.customer, order.total_cents, order.status, order.created_at);
+  return { ...order, id: Number(result.lastInsertRowid) };
+}

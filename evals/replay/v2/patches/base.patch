@@ -0,0 +1,48 @@
+import { readFileSync } from "node:fs";
+
+/** The service's tunables. `config/service.json` holds the deployed values. */
+export interface ServiceConfig {
+  /** Orders per page when a request names no size. */
+  pageSizeDefault: number;
+  /** The largest page a request may ask for. */
+  maxPageSize: number;
+  /** How long closed orders are kept, in days. */
+  retentionDays: number;
+}
+
+/** The documented defaults (docs/api.md, Configuration). */
+export const DEFAULTS: ServiceConfig = {
+  pageSizeDefault: 20,
+  maxPageSize: 100,
+  retentionDays: 30,
+};
+
+function positiveInteger(name: keyof ServiceConfig, value: unknown): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 1) {
+    throw new Error(`config: ${name} must be a positive integer, got ${JSON.stringify(value)}`);
+  }
+  return value;
+}
+
+/** The defaults overlaid with `raw`, every key validated. Throws naming the first bad key. */
+export function loadConfig(raw: Partial<ServiceConfig> = {}): ServiceConfig {
+  const merged = { ...DEFAULTS, ...raw };
+  const config: ServiceConfig = {
+    pageSizeDefault: positiveInteger("pageSizeDefault", merged.pageSizeDefault),
+    maxPageSize: positiveInteger("maxPageSize", merged.maxPageSize),
+    retentionDays: positiveInteger("retentionDays", merged.retentionDays),
+  };
+  if (config.pageSizeDefault > config.maxPageSize) {
+    throw new Error(`config: pageSizeDefault (${config.pageSizeDefault}) exceeds maxPageSize (${config.maxPageSize})`);
+  }
+  return config;
+}
+
+/** Read and validate a JSON config file. */
+export function readConfigFile(path: string): ServiceConfig {
+  const parsed: unknown = JSON.parse(readFileSync(path, "utf8"));
+  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new Error(`config: ${path} must hold a JSON object`);
+  }
+  return loadConfig(parsed as Partial<ServiceConfig>);
+}

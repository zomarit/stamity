@@ -0,0 +1,62 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { DatabaseSync } from "node:sqlite";
+import { loadConfig } from "../src/config/load.ts";
+import { createApp, type AppDeps } from "../src/http/app.ts";
+import { openDb } from "../src/store/db.ts";
+
+/** The one token `startApp` accepts unless a test passes its own. */
+export const TOKEN = "test-token";
+
+export interface Started {
+  url: string;
+  close(): Promise<void>;
+  db: DatabaseSync;
+  bus: AppDeps["bus"];
+  /** The serialized events the default bus has received, as published. */
+  lines: string[];
+}
+
+/** The app on a free port over a fresh database, with any of its dependencies replaced. */
+export async function startApp(deps: Partial<AppDeps> = {}): Promise<Started> {
+  const lines: string[] = [];
+  const invoiceDir = mkdtempSync(join(tmpdir(), "replay-orders-invoices-"));
+  const full: AppDeps = {
+    db: openDb(),
+    tokens: new Set([TOKEN]),
+    config: loadConfig(),
+    bus: {
+      publish(raw) {
+        lines.push(raw);
+      },
+    },
+    invoiceDir,
+    ...deps,
+  };
+  const server = createServer(createApp(full));
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const { port } = server.address() as AddressInfo;
+  return {
+    url: `http://127.0.0.1:${port}`,
+    db: full.db,
+    bus: full.bus,
+    lines,
+    close: () =>
+      new Promise<void>((resolve, reject) => {
+        server.close((error) => {
+          rmSync(invoiceDir, { recursive: true, force: true });
+          if (error) reject(error);
+          else resolve();
+        });
+      }),
+  };
+}
+
+/** GET `path` with the test token (or `token`, or none when null). */
+export async function get(app: Started, path: string, token: string | null = TOKEN): Promise<Response> {
+  const headers: Record<string, string> = token === null ? {} : { authorization: `Bearer ${token}` };
+  return await fetch(`${app.url}${path}`, { headers });
+}

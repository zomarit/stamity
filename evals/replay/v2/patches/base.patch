+import { beforeEach, describe, expect, it } from "vitest";
+import type { DatabaseSync } from "node:sqlite";
+import { insertOrder, openDb } from "../src/store/db.ts";
+import { getOrder, listOrders, setStatus } from "../src/store/query.ts";
+
+let db: DatabaseSync;
+
+beforeEach(() => {
+  db = openDb();
+  insertOrder(db, { customer: "Ada", total_cents: 1250, status: "open", created_at: "2026-09-01T10:00:00Z" });
+  insertOrder(db, { customer: "Bo", total_cents: 300, status: "paid", created_at: "2026-09-03T10:00:00Z" });
+  insertOrder(db, { customer: "Cy", total_cents: 90, status: "open", created_at: "2026-09-02T10:00:00Z" });
+});
+
+describe("listOrders", () => {
+  it("returns the newest orders first, at most size of them", () => {
+    expect(listOrders(db, { size: 2 }).map((row) => row.customer)).toEqual(["Bo", "Cy"]);
+    expect(listOrders(db, { size: 10 })).toHaveLength(3);
+  });
+});
+
+describe("getOrder", () => {
+  it("finds an order by id and misses an unknown one", () => {
+    expect(getOrder(db, 1)).toEqual({ id: 1, customer: "Ada", total_cents: 1250, status: "open", created_at: "2026-09-01T10:00:00Z" });
+    expect(getOrder(db, 42)).toBeUndefined();
+  });
+});
+
+describe("setStatus", () => {
+  it("updates an existing order and reports a missing one", () => {
+    expect(setStatus(db, 2, "cancelled")).toBe(true);
+    expect(getOrder(db, 2)?.status).toBe("cancelled");
+    expect(setStatus(db, 42, "cancelled")).toBe(false);
+  });
+});

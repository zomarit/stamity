diff --git a/src/store/paging.ts b/src/store/paging.ts
new file mode 100644
index 0000000000000000000000000000000000000000..59c112198ba5ed7f9d53c1562e174798cdb58c57
--- /dev/null
+++ b/src/store/paging.ts
@@ -0,0 +1,7 @@
+/**
+ * How many rows come before page `page` when every page holds `size` rows; pages are 1-based
+ * (docs/api.md, Paging).
+ */
+export function pageOffset(page: number, size: number): number {
+  return (page - 1) * size;
+}

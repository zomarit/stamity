 import type { DatabaseSync } from "node:sqlite";
 import type { OrderRow } from "./db.ts";
 
+/** The columns a list may be ordered by: the order's own keys (docs/api.md, Orders). */
+export const SORT_COLUMNS: ReadonlySet<string> = new Set(["id", "customer", "total_cents", "status", "created_at"]);
+
 export interface ListOptions {
   /** How many orders to return, already validated against the configured maximum. */
   size: number;
+  /** The column to order by, largest first; `created_at` (newest first) when absent. */
+  sort?: string;
+  /** How many rows to skip before the first one returned. */
+  offset?: number;
 }
 
-/** The newest orders first, at most `size` of them. */
-export function listOrders(db: DatabaseSync, { size }: ListOptions): OrderRow[] {
-  const sql = "SELECT id, customer, total_cents, status, created_at FROM orders ORDER BY created_at DESC LIMIT ?";
-  return db.prepare(sql).all(size) as OrderRow[];
+/** The orders by `sort`, largest first, at most `size` of them after the first `offset`. */
+export function listOrders(db: DatabaseSync, { size, sort = "created_at", offset = 0 }: ListOptions): OrderRow[] {
+  const column = SORT_COLUMNS.has(sort) ? sort : "created_at";
+  const sql = `SELECT id, customer, total_cents, status, created_at FROM orders ORDER BY ${column} DESC LIMIT ? OFFSET ?`;
+  return db.prepare(sql).all(size, offset) as OrderRow[];
 }
 
 /** One order by id, or `undefined` when there is none. */

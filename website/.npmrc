# Dependency lifecycle scripts do not run on install — the same policy as the repository root's
# .npmrc, restated here because it does NOT reach this directory on its own.
#
# WHY A SECOND FILE. npm resolves the *project* config from the project root it computes for the
# install, not from the directory the repository happens to start at. Once `website/` has its own
# package.json it IS that root, so the root .npmrc stops applying. This is measurable rather than
# argued:
#
#   $ (cd .. && npm config get ignore-scripts)   -> true
#   $ npm config get ignore-scripts              -> false      # before this file existed
#
# Without it, `npm install` run here by a maintainer executes preinstall/install/postinstall from
# every package in a 766-package tree, transitive ones included, with that maintainer's
# privileges — the exact exposure the root file exists to remove, reachable by cd'ing one level
# down. The CI lane in .github/workflows/docs-site.yml passes `--ignore-scripts` on its own line
# for the same reason; this file covers the install CI does not run.
#
# The trade is the root file's trade: a dependency that genuinely needs a build step will not
# build. Docusaurus's tree needs none — `npm ci --ignore-scripts` installs it and `npm run build`
# produces the site. The remedy if that ever changes is a NAMED `npm rebuild <package>` step at
# the site that needs it, never a blanket re-enable.
ignore-scripts=true

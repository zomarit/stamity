# Both forms: the slash form matches a directory only, and a worktree of this repository carries node_modules as a symlink to the main checkout's tree, which only the bare form matches.
node_modules/
node_modules
dist/
coverage/
*.tsbuildinfo

# The docs site's build output and its incremental cache. Both are regenerated by
# `npm run build` in website/; website/node_modules is already covered by the rule above.
website/build/
website/.docusaurus/

.env
.env.*
!.env.example

# The upstream lane's update worktrees (scripts/upstream.mjs): one linked worktree per release
# under here, on its own branch, so a merge in progress never touches the operator's tree.
.stamity/upstream-work/

# Per-session state and scratch; generated hooks and evidence records stay tracked.
/.claude/worktrees/
/.claude/settings.local.json
# Claude Code's local session state. Exact entries only: .claude/ also holds tracked, emitted
# agents, commands, rules, skills and settings, so no rule here may widen past these names.
/.claude/scheduled_tasks.lock
/.claude/scheduled_tasks.json
/.claude/routines/.state/
/.claude/checkpoints/
/.claude/mailbox/
/.claude/agent-registry.json
/.claude/agent-memory-local
/.claude/first-run
/.claude/assistant-daemon-state.json
/.stamity/review-gate.json
/.stamity/review-gate.json.lock
/.stamity/review-gate.json.tmp-*
# A run's full role reports stay local; the ledger row carries the path (C1).
/.stamity/runs/*/reports/
/.stamity/runs/*/ledger.jsonl.lock
/.stamity/runs/*/ledger.jsonl.tmp.*
/.stamity/_scratch/
/.stamity/_runtime/

# Eval runners retain raw evidence locally for Release archives. Compact run
# records stay tracked; these rules do not remove already tracked history.
/evals/runs/*/calls/
/evals/runs/*/calls.json
/evals/runs/*/samples.jsonl
/evals/runs/*/*-attempt-*.json
/evals/runs/*/sample-*.json
/evals/runs/*/isolation-*.json
/evals/runs/*/provider-responses.jsonl

# Python and tool caches and process locks, anywhere in the tree; scripts/repo-hygiene.mjs
# refuses the same names as tracked runtime files (test/fixtures/ excepted there).
__pycache__/
.venv/
.pytest_cache/
.cache/
*.pid
*.pid.lock

# `npm pack` output at the root; a tarball deeper in the tree is not pack output.
/*.tgz

# Root-level session scratch. The leak gate walks tracked AND
# untracked-but-not-ignored files (scripts/leak-gate.mjs, `listFromGit`), so a local
# note holding names the gate reserves keeps every run red until the path leaves that
# set — and the same entry is what keeps it out of a `git add -A`. Anchored to the root
# so a tracked `docs/temp.md` would still be scanned and still be committable.
/temp.md

.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# Dependency lifecycle scripts do not run on install.
#
# `npm ci` and `npm install` otherwise execute preinstall/install/postinstall from every
# package in the tree, transitive ones included, with the full privileges of whoever is
# installing. That is the shortest path a compromised transitive release has to a CI runner
# or a maintainer laptop, and it runs before any gate in this repo sees a byte.
#
# Scope: npm reads the project config from the .npmrc of the directory the command runs in,
# so this file covers every install whose cwd is this repository — the CI legs and a
# maintainer clone. An install into a DIFFERENT directory does not inherit it, which is why
# the throwaway consumer project in `scripts/tarball-smoke.mjs` passes `--ignore-scripts` on
# its own install line rather than relying on this file.
#
# The trade: a dependency that genuinely needs a build step (a native addon) will not build.
# The remedy is a NAMED `npm rebuild <package>` step at the site that needs it, never a
# blanket re-enable. No dependency in this tree needs one today; adding an npm script for it
# would edit package.json, so the day one does, it lands as an explicit CI step.
ignore-scripts=true

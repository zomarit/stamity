    );
    if (policy === undefined) {
      return {
        ...subject,
        reasonCode: "NO_POLICY",
        message: \`No policy is registered for agent "\${agentId}", so it may use nothing. Add a grant for it to the roster and regenerate the setup.\`,
      };

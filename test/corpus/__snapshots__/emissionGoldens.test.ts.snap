  process.stderr.write(
    JSON.stringify({ hook: "stamity-pre-tool-use-guard", blocked: BLOCKING, ...refusal }) + "\\n",
  );
  process.exitCode = BLOCKING ? BLOCK_EXIT : 0;
}
"

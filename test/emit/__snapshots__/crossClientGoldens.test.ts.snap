  {"kind":"cursor-agent","vars":["CURSOR_AGENT_SOCKET"],"name":"a Cursor agent machine (managed or self-hosted)","lines":[]},
  {"kind":"ci","vars":["CI","GITHUB_ACTIONS"],"name":"a CI run","lines":["No person answers; declared defaults apply."]},

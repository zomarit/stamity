        "--header",
        "Authorization: Bearer \${env:GITHUB_PAT}",
        "--header",
        "X-MCP-Toolsets: repos,issues,pull_requests"
      ],
      "env": {
        "GITHUB_PAT": "\${env:GITHUB_PAT}"
      }
    }

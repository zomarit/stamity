  ".github/workflows/copilot-setup-steps.yml": "name: Copilot Setup Steps

# Prepares the environment the GitHub Copilot coding agent works in. The agent runs
# the job named \`copilot-setup-steps\` below and nothing else in this file.
# Generated — edits are overwritten on the next sync.

on:
  workflow_dispatch:
  push:
    paths:
      - .github/workflows/copilot-setup-steps.yml
  pull_request:
    paths:
      - .github/workflows/copilot-setup-steps.yml

jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    # The platform accepts at most 59 here; a stuck install stops at this bound.
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      # Pin these to a full-length commit SHA for a stricter supply-chain posture.
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v7
        with:
          # No .nvmrc, .node-version or engines.node pin was found, so the current LTS.
          node-version: "lts/*"
      - run: corepack enable
      - run: pnpm install --frozen-lockfile
      # The pinned stamity CLI, at the version this file was generated with: the flows'
      # \`gate scan\` and \`ledger status\` then find \`stamity\` on PATH with no registry fetch.
      - run: npm install --global @zomarit/stamity@1.0.0-golden
      - run: stamity --version
",
  ".mcp.json": "{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.16",
        "https://api.githubcopilot.com/mcp/",
        "--header",
        "Authorization: Bearer \${GITHUB_PAT}",
        "--header",
        "X-MCP-Toolsets: repos,issues,pull_requests"
      ],
      "env": {
        "GITHUB_PAT": "\${GITHUB_PAT}"
      }
    }
  }
}
",

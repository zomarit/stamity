  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \\"\${CLAUDE_PROJECT_DIR}/.claude/hooks/stamity/stamity-session-start.mjs\\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \\"\${CLAUDE_PROJECT_DIR}/.claude/hooks/stamity/stamity-config-tamper-notice.mjs\\"",
            "timeout": 30
